# ============================================
# NexaPay Environment Variables
# ============================================
# Copy file ini ke .env.local dan isi dengan credentials asli.
# JANGAN commit .env.local ke repository!
#
#   cp .env.example .env.local
#
# ============================================

# === Prisma Database Connection ===
DATABASE_URL="file:./dev.db"

# === Auth.js (NextAuth) ===
# Generate secret: openssl rand -base64 32
AUTH_SECRET="GANTI_DENGAN_RANDOM_SECRET_MINIMAL_32_KARAKTER"
AUTH_URL="http://localhost:3000"

# === Google OAuth ===
# Buat di: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# === Discord OAuth ===
# Buat di: https://discord.com/developers/applications
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# === Gemini AI (untuk chatbot) ===
# Buat di: https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# === App Configuration ===
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NexaPay"
