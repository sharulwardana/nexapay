// ─── NexaPay Database Schema ────────────────────────────────────────
//
// MIGRATION NOTES (Phase 3):
// 
// 1. DATABASE ENGINE:
//    Current: SQLite (development only — single-writer, not suitable for production)
//    Target:  PostgreSQL 16 (Neon/Supabase/Railway for production)
//    Action:  Change provider below from "sqlite" to "postgresql"
//            and update DATABASE_URL in .env.local to a PostgreSQL connection string.
//
// 2. MONETARY FIELDS (Float → Int):
//    Current: Float (e.g., walletBalance Float, price Float)
//    Issue:   Floating point arithmetic causes rounding errors in financial calculations
//    Target:  Int (store values in smallest unit — Rupiah, no decimals)
//    Fields to migrate:
//      - User.walletBalance
//      - Denomination.price, .originalPrice, .flashSalePrice, .discount
//      - Transaction.amount, .discount, .totalAmount
//      - Promo.value, .minPurchase, .maxDiscount
//      - Referral.bonus
//    Action:  After switching to PostgreSQL, run prisma migrate to create migration history.
//
// 3. MIGRATION STRATEGY:
//    a. Switch provider to "postgresql"
//    b. Run `npx prisma migrate dev --name init` to create initial migration
//    c. Change Float fields to Int
//    d. Run `npx prisma migrate dev --name monetary-int-conversion`
//    e. Update all API routes to handle Int values (remove Math.floor where unnecessary)
//
// ────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  role          String    @default("USER")
  walletBalance Int       @default(0)
  loyaltyLevel  String    @default("BRONZE")
  loyaltyPoints Int       @default(0)
  referralCode  String?   @unique
  referredBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastCheckIn   DateTime?
  lastScratch   DateTime?

  accounts       Account[]
  sessions       Session[]
  transactions   Transaction[]
  favorites      Favorite[]
  notifications  Notification[]
  referralsGiven Referral[]     @relation("Referrer")
  referralsUsed  Referral[]     @relation("Referee")
  coupons        UserCoupon[]
  chatMessages   ChatMessage[]

  @@index([email])
  @@index([referralCode])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  category    String
  subcategory String?
  description String?
  image       String
  bannerImage String?
  publisher   String?
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  isPopular   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  denominations Denomination[]
  transactions  Transaction[]
  favorites     Favorite[]

  @@index([slug])
  @@index([category])
  @@index([isActive, isFeatured])
}

model Denomination {
  id             String    @id @default(cuid())
  productId      String
  label          String
  value          Int
  price          Int
  originalPrice  Int?
  discount       Int?
  stock          Int       @default(-1)
  isActive       Boolean   @default(true)
  isPopular      Boolean   @default(false)
  isFlashSale    Boolean   @default(false)
  flashSalePrice Int?
  flashSaleEnd   DateTime?
  sortOrder      Int       @default(0)

  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([productId])
}

model Transaction {
  id             String    @id @default(cuid())
  invoiceId      String    @unique @default(cuid())
  userId         String
  productId      String
  denominationId String
  quantity       Int       @default(1)
  amount         Int
  discount       Int       @default(0)
  totalAmount    Int
  paymentMethod  String
  status         String    @default("PENDING")
  gameUserId     String?
  gameServerId   String?
  phoneNumber    String?
  accountNumber  String?
  email          String?
  promoCode      String?
  notes          String?
  paymentProof   String?
  paidAt         DateTime?
  completedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  denomination Denomination @relation(fields: [denominationId], references: [id])

  @@index([userId])
  @@index([invoiceId])
  @@index([status])
  @@index([createdAt])
}

model Promo {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  type         String
  value        Int
  minPurchase  Int      @default(0)
  maxDiscount  Int?
  usageLimit   Int      @default(-1)
  usageCount   Int      @default(0)
  perUserLimit Int      @default(1)
  startDate    DateTime
  endDate      DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([code])
  @@index([isActive])
}

model Banner {
  id          String    @id @default(cuid())
  title       String
  subtitle    String?
  image       String
  mobileImage String?
  link        String?
  position    String    @default("home_hero")
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime  @default(now())

  @@index([position, isActive])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  refereeId  String
  bonus      Int      @default(0)
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id])
  referee  User @relation("Referee", fields: [refereeId], references: [id])

  @@index([referrerId])
}

model UserCoupon {
  id        String    @id @default(cuid())
  userId    String
  promoCode String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String?
  sender    String   @default("user")
  message   String
  isBot     Boolean  @default(false)
  sessionId String
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([sessionId])
}

model NewsArticle {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  image       String?
  author      String    @default("NexaPay Team")
  category    String    @default("news")
  tags        String    @default("[]")
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model SiteConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@index([key])
}
